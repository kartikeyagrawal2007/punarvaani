# =============================================================================
# Punarvaani .gitignore
# Rule of thumb: code and documentation are tracked; data, weights, media,
# tool caches and generated reports are not.
# =============================================================================

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
build/
dist/
site/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
pip-log.txt
pip-wheel-metadata/

# --- Secrets / local machine config -----------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
credentials*.json
token*.json
.huggingface/
.commandcode/

# --- Datasets (privacy: faces, voices and transcripts never go to git) ------
# NOTE: do NOT add a bare /data/ rule. On Windows and macOS the filesystem is
# case-insensitive, so "/data/" would also ignore the tracked source folder
# "Data/". Use the explicit dataset folder names below instead.
/datasets/
/raw/
/raw_videos/
/recordings/
/hindi_dataset/*
!/hindi_dataset/README.md
/hindi_dataset_test/
/sarvam_data/
/frames/
/crops/
/.tmp/
.tmp/
*.jsonl
*.csv
*.tsv
*.parquet
*.arrow
preflight_report.json
preprocessing_report.json
synthetic_manifest.json
ctc_loss_inputs.csv

# --- Model weights and training outputs -------------------------------------
# Keep the handover README, ignore everything else in checkpoints/.
/checkpoints/*
!/checkpoints/sarvam_lora/
/checkpoints/sarvam_lora/*
!/checkpoints/sarvam_lora/README.md
/outputs/
/runs/
/wandb/
/lightning_logs/
/models_cache/
*.pt
*.pth
*.ckpt
*.safetensors
*.safetensors.index.json
*.bin
*.onnx
*.tflite
*.gguf
*.ggml
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.model
*.msgpack
*.npy
*.npz

# --- Media (privacy: no faces or voices in git) -----------------------------
*.mp4
*.m4v
*.avi
*.mov
*.mkv
*.webm
*.wmv
*.flv
*.3gp
*.wav
*.flac
*.mp3
*.m4a
*.aac
*.wma
*.opus
*.ogg
*.aiff
*.pcm

# --- Generated logs / temporary files ---------------------------------------
*.log
/logs/
*.tmp
*.temp
*.bak
*.orig
*.rej

# --- OS / editors -----------------------------------------------------------
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
.history/
*.swp
*.swo
*~
